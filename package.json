{
  "name": "housing-toronto",
  "version": "1.0.0",
  "description": "An application to provide ease of access to available homeless shelters",
  "main": "server.js",
  "scripts": {
    "server": "node server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "build": "npm install --include=dev --prefix client && npm run build --prefix client",
    "start": "npm run build && node server.js",
    "build:shelter-coords": "node scripts/build-shelter-coords.js",
    "build:toronto-fsa": "node scripts/build-toronto-fsa.js",
    "export:shelter-targets": "node scripts/export-shelter-targets.js",
    "merge:shelter-profile": "node scripts/merge-shelter-profile.js",
    "research:shelters": "node scripts/research-shelter-profiles.js",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.*\"",
    "test:research": "node --test tests/research-agent.test.js"
  },
  "author": "Terry Kim",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.8.4"
  },
  "keywords": [],
  "devDependencies": {
    "concurrently": "^10.0.6",
    "socket.io-client": "^4.8.4"
  }
}
